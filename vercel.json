{
  "buildCommand": "npm install && cd server && npm install",
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/cron/usage-readings",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/[...slug].js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/[...slug]"
    }
  ]
}
