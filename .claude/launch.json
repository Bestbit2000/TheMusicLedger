{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "music-ledger",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "music-ledger-csp",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=server/.env",
        "--env-file=.claude/csp-enforce.tmp.env",
        "server/server.js"
      ],
      "port": 3100
    }
  ]
}
