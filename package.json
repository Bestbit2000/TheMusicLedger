{
  "name": "the-music-ledger",
  "version": "0.28.0",
  "description": "Music practice tracking app with Google Sheets",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd server && npm run dev",
    "build": "npm install && cd server && npm install",
    "sync-releases": "node scripts/sync-releases.mjs",
    "cut-release": "node scripts/cut-release.mjs",
    "migrate": "node db/migrate.js",
    "backtest": "node scripts/run-backtest.mjs",
    "prepare": "husky",
    "token-audit": "node scripts/token-audit.mjs",
    "token-reference": "node scripts/build-token-reference.mjs",
    "design-gate": "node scripts/design-gate.mjs",
    "design-signoff": "node --env-file=.env scripts/design-signoff-shots.mjs",
    "a11y-audit": "node scripts/a11y-audit.mjs",
    "a11y-scan": "playwright test --config playwright.a11y.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neon/config": "^1.3.1",
    "@neon/env": "^1.2.2",
    "axios": "^1.6.2",
    "body-parser": "^1.20.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7"
  }
}
