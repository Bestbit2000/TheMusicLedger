{
  "name": "the-music-ledger",
  "version": "0.4.1",
  "description": "Music practice tracking app with Google Sheets",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "cd server && npm run dev",
    "build": "npm install && cd server && npm install",
    "sync-releases": "node scripts/sync-releases.mjs",
    "cut-release": "node scripts/cut-release.mjs",
    "migrate": "node db/migrate.js",
    "prepare": "husky"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neon/config": "^1.3.1",
    "@neon/env": "^1.2.2",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "googleapis": "^118.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
