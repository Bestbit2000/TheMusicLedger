# Used by scripts/sync-releases.mjs to pull released versions from Jira.
# Generate an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://bestbit2000.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ML

# ML-179: file storage for Flow recordings/documents (mp3/mp4/YouTube, PDF/MusicXML).
# Auto-injected by Vercel once a Blob store is attached to the project in the
# dashboard - for local dev, copy that same value in from the Vercel project's
# own environment variables (Settings > Environment Variables) rather than
# generating a separate one, so local uploads land in the same store you'll see
# in production/sandbox.
BLOB_READ_WRITE_TOKEN=
